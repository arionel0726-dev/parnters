{
  "name": "@vizaje/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --hot src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "bootstrap:admin": "bun --env-file=../../.env src/cli/bootstrap-admin.ts",
    "referral-links:backfill:dry-run": "bun --env-file=../../.env src/cli/referral-links-backfill-dry-run.ts",
    "test": "bun --env-file=../../.env test",
    "e2e:fixture": "bun --env-file=../../.env src/cli/e2e-fixture.ts",
    "test:unit": "bun --env-file=../../.env test test/pure.test.ts test/legacy-resolver.test.ts",
    "test:typecheck": "tsc --ignoreConfig --noEmit --target ESNext --module Preserve --moduleResolution Bundler --lib ESNext --types bun --strict --skipLibCheck --allowImportingTsExtensions test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@vizaje/contracts": "workspace:*",
    "@vizaje/db": "workspace:*",
    "better-auth": "1.7.15",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "hono": "latest",
    "pino": "^10.4.0",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  }
}
