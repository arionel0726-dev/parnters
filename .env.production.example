# Docker Compose / PostgreSQL
POSTGRES_DB=vizaje_partners
POSTGRES_USER=partners
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://partners:replace-with-a-long-random-database-password@postgres:5432/vizaje_partners

# Runtime
NODE_ENV=production
API_PORT=3001

# Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://partners-api.vizaje-nica.com
AUTH_TRUSTED_ORIGINS=https://partners.vizaje-nica.com,https://partners-api.vizaje-nica.com

# Application URLs
WEB_APP_URL=https://partners.vizaje-nica.com
NEXT_PUBLIC_API_BASE_URL=https://partners-api.vizaje-nica.com
API_INTERNAL_URL=http://api:3001

# Referral links and internal service authentication
REFERRAL_SERVICE_TOKEN=replace-with-a-long-internal-service-token
REFERRAL_SHORT_URL_ORIGIN=https://partners.vizaje-nica.com
VIZAJE_DESTINATION_HOSTS=vizaje-nica.com,www.vizaje-nica.com,ru.vizaje-nica.com,ro.vizaje-nica.com

# Legacy resolver: keep disabled until the development Legacy instance is verified.
LEGACY_RESOLVER_ENABLED=false
LEGACY_INTERNAL_BASE_URL=
LEGACY_RESOLVER_HMAC_KEYS=
LEGACY_TO_PARTNERS_HMAC_KEYS=
LEGACY_ACCOUNT_LINK_REDIRECT_URI=

# Email delivery (Resend)
RESEND_API_KEY=
EMAIL_FROM="Vizaje Partners <partners@vizaje-nica.com>"

# Production safety switches: keep disabled until explicitly approved.
CREATOR_FINANCE_ENABLED=false
PAYOUTS_ENABLED=false
REFERRAL_TRACKING_ENABLED=false

# Audit retention policy
AUDIT_TECHNICAL_RETENTION_DAYS=4
AUDIT_BUSINESS_RETENTION_DAYS=365
AUDIT_FINANCIAL_RETENTION_DAYS=2555
