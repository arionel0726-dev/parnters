# Vizaje Partners isolated dev profile.
# This file contains placeholders only. Store real values in .env.partners-dev,
# which remains ignored by Git.

# PostgreSQL is private to the Compose network.
POSTGRES_DB=vizaje_partners_dev
POSTGRES_USER=partners_dev
POSTGRES_PASSWORD=replace-with-dev-only-database-password
DATABASE_URL=postgresql://partners_dev:replace-with-dev-only-database-password@postgres:5432/vizaje_partners_dev

# Run the isolated environment in production mode with dev-only infrastructure.
NODE_ENV=production
API_PORT=3001

# Better Auth: these are proposed hostnames and are not DNS-confirmed yet.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters-for-partners-dev
BETTER_AUTH_URL=https://partners-api-dev.vizaje-nica.com
AUTH_TRUSTED_ORIGINS=https://partners-dev.vizaje-nica.com,https://partners-api-dev.vizaje-nica.com

# Public/private application URLs.
WEB_APP_URL=https://partners-dev.vizaje-nica.com
NEXT_PUBLIC_API_BASE_URL=https://partners-api-dev.vizaje-nica.com
API_INTERNAL_URL=http://api:3001

# Dev links must point only at the Legacy dev host, never the production store.
REFERRAL_SERVICE_TOKEN=replace-with-dev-only-internal-service-token
REFERRAL_SHORT_URL_ORIGIN=https://partners-dev.vizaje-nica.com
VIZAJE_DESTINATION_HOSTS=dev.vizaje-nica.com

# Keep the Partners -> Legacy resolver disabled in this profile.
LEGACY_RESOLVER_ENABLED=false
LEGACY_INTERNAL_BASE_URL=
LEGACY_RESOLVER_HMAC_KEYS=

# Separate Legacy -> Partners key rings. Do not reuse resolver or account-linking keys.
LEGACY_TO_PARTNERS_HMAC_KEYS=
LEGACY_ANALYTICS_HMAC_KEYS=[{"keyId":"legacy-analytics-to-partners-dev-2026-11","secret":"<replace-with-43-char-base64url-secret>","active":true}]
LEGACY_ACCOUNT_LINK_REDIRECT_URI=https://dev.vizaje-nica.com/account/creator-link/callback

# Email is optional for local smoke tests; configure a dev Resend key only if needed.
RESEND_API_KEY=
EMAIL_FROM=Vizaje Partners Dev <partners@vizaje-nica.com>

# Enable only the M5.4 analytics module in the isolated dev environment.
CREATOR_FINANCE_ENABLED=false
PAYOUTS_ENABLED=false
REFERRAL_TRACKING_ENABLED=false
REFERRAL_ANALYTICS_ENABLED=true
# Required for controlled analytics: set the exact test creator Partner UUID.
REFERRAL_ANALYTICS_ALLOWED_PARTNER_IDS=

# Retention defaults.
AUDIT_TECHNICAL_RETENTION_DAYS=4
AUDIT_BUSINESS_RETENTION_DAYS=365
AUDIT_FINANCIAL_RETENTION_DAYS=2555
