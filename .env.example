# Database
DATABASE_URL=postgresql://partners:partners_local_dev_only@127.0.0.1:5434/vizaje_partners

# Authentication (Better Auth)
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:3001
# Comma-separated origins allowed to use the API
AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Application URLs and local ports
API_PORT=3001
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001
API_INTERNAL_URL=http://127.0.0.1:3001
WEB_APP_URL=http://localhost:3000

# Referral links and internal service authentication
REFERRAL_SERVICE_TOKEN=replace-with-a-long-internal-service-token
REFERRAL_SHORT_URL_ORIGIN=http://localhost:3000
VIZAJE_DESTINATION_HOSTS=vizaje-nica.com,www.vizaje-nica.com,ru.vizaje-nica.com,ro.vizaje-nica.com,localhost:3000,127.0.0.1:3000

# Legacy resolver (M5.1B). Keep disabled until Legacy's auth tables and endpoint are operational.
LEGACY_RESOLVER_ENABLED=false
# Internal Legacy API origin only; do not include a path, query, or credentials.
LEGACY_INTERNAL_BASE_URL=
# JSON array key ring for the partners-to-legacy direction only, for example:
# [{"keyId":"partners-to-legacy-2026-01","secret":"<43+ char unpadded base64url for >=32 random bytes>","active":true}]
# Keep secrets server-only; never use a NEXT_PUBLIC_ variable or put a real secret in this example file.
LEGACY_RESOLVER_HMAC_KEYS=

# Legacy -> Partners account linking. Keep disabled by omission until Legacy is configured.
# [{"keyId":"legacy-to-partners-2026-11","secret":"<43+ char unpadded base64url for >=32 random bytes>","active":true}]
LEGACY_TO_PARTNERS_HMAC_KEYS=
# Exact callback URI registered by Legacy; no arbitrary browser redirect is accepted.
LEGACY_ACCOUNT_LINK_REDIRECT_URI=

# Email delivery (Resend)
RESEND_API_KEY=
EMAIL_FROM=Vizaje Partners <partners@vizaje-nica.com>

# Safety switches. Keep disabled until the corresponding production dependency and business rules are approved.
CREATOR_FINANCE_ENABLED=false
PAYOUTS_ENABLED=false
REFERRAL_TRACKING_ENABLED=false

# Audit retention policy. Technical events are short-lived; business and financial events are retained conservatively.
AUDIT_TECHNICAL_RETENTION_DAYS=4
AUDIT_BUSINESS_RETENTION_DAYS=365
AUDIT_FINANCIAL_RETENTION_DAYS=2555
